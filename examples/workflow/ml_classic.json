{
  "name": "classic-tabular-classification",
  "experiment_type": "ml_classic",
  "monitoring": {
    "enable_emissions": false,
    "environment_cost_per_hour_usd": 0.1
  },
  "tasks": [
    {
      "task_id": "prepare_data",
      "name": "Preparar dados tabulares",
      "task_type": "prepare",
      "command": ["python", "scripts/prepare_tabular.py"],
      "config": {"dataset": "data/train.csv", "target": "label"},
      "input_signatures": {"dataset": "replace-with-dataset-hash"},
      "artifacts": {"dataset": "output/tabular/prepared.parquet"}
    },
    {
      "task_id": "train_model",
      "name": "Treinar classificador",
      "task_type": "train",
      "depends_on": ["prepare_data"],
      "command": ["python", "scripts/train_sklearn.py"],
      "config": {"estimator": "RandomForestClassifier", "n_estimators": 200},
      "artifacts": {"model": "output/tabular/model.joblib"}
    },
    {
      "task_id": "evaluate_model",
      "name": "Avaliar classificador",
      "task_type": "evaluate",
      "depends_on": ["train_model"],
      "command": ["python", "scripts/evaluate_sklearn.py"],
      "artifacts": {"predictions": "output/tabular/predictions.csv"}
    }
  ]
}